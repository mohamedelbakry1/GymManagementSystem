@{
    ViewData["Title"] = "Delete User";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card p-5 shadow text-center">
                <div class="mb-3">
                    <i class="bi bi-person-x display-1 text-danger"></i>
                </div>
                <p class="fs-4 text-primary-color mb-2">Are you sure you want to delete this user?</p>

                <div class="card bg-light border-0 p-3 mb-3 text-start">
                    <p class="mb-1"><strong>Name:</strong> @ViewBag.UserFullName</p>
                    <p class="mb-1"><strong>Email:</strong> @ViewBag.UserEmail</p>
                    <p class="mb-0">
                        <strong>Role:</strong>
                        <span class="badge @(ViewBag.UserRole == "SuperAdmin" ? "bg-danger" : "bg-primary")">
                            @ViewBag.UserRole
                        </span>
                    </p>
                </div>

                <div class="alert alert-warning text-start" role="alert">
                    <strong>Warning!</strong> This action cannot be undone.
                    The user will lose access to the system permanently.
                </div>

                <form asp-action="DeleteConfirmed" method="post" class="mt-2">
                    <input hidden readonly name="Id" value="@ViewBag.UserId" />
                    <div class="buttons d-flex justify-content-between gap-3">
                        <a asp-controller="User" asp-action="Index" class="btn-outline flex-fill">NO</a>
                        <button type="submit" class="btn-fill flex-fill">Yes, Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


